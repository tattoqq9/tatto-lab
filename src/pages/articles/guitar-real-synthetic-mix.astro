  .reasoning-flow b { color: var(--text-subtle); }
  .series-flow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 10px; align-items: center; margin: 3rem 0; }
  .series-flow a, .series-flow > div { padding: 20px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); text-align: center; }
  .series-flow a:hover { border-color: var(--border-strong); box-shadow: var(--shadow-soft); }
  .series-flow strong { display: block; margin-top: 7px; font-size: .92rem; line-height: 1.5; }
  .series-flow > b { color: var(--text-subtle); text-align: center; }
  .article-nav { display: grid; grid-template-columns: 1fr 1fr .65fr; gap: 14px; margin-top: 5rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .article-nav a { padding: 20px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); }
  .article-nav a:hover { border-color: var(--border-strong); box-shadow: var(--shadow-soft); }
  .article-nav span { display: block; margin-bottom: 8px; color: var(--accent); font-size: .72rem; font-weight: 700; }
  .article-nav strong { display: block; font-size: .9rem; line-height: 1.55; }

  @media (max-width: 700px) {
    .article-header { padding-top: 42px; }
    .back { margin-bottom: 50px; }
    h1 span { display: inline; }
    h1 span + span::before { content: " "; }
    .media { width: 100%; margin-left: 0; transform: none; }
    .dataset-flow, .series-flow { grid-template-columns: 1fr; }
    .dataset-flow > b, .series-flow > b { text-align: center; }
    .role-grid, .metrics, .article-nav { grid-template-columns: 1fr; }
    .final-table { overflow-x: auto; }
    .final-table > div { min-width: 600px; }
  }
</style>
