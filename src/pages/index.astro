---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Guitar AI",
    description: "自分のギターを高精度に切り抜くための専用AIを開発しています。",
    status: "In Development",
    href: "/projects/guitar-ai",
  },
  {
    title: "Inheritance Village",
    description: "コンペに向け約2週間で制作した、失敗と感情を次世代へ継承するローカルLLM社会シミュレーション。",
    status: "Competition Entry · Aug 2026",
    href: "/projects/agent-society",
  },
  {
    title: "Voxel World",
    description: "Voxel世界を舞台に、AIや魔法による大規模な戦争を作るゲームプロジェクト。",
    status: "In Development",
    href: "/projects/voxel-world",
  },
  {
    title: "SNAPOUT",
    description: "現実世界・都市データとゲームを組み合わせたインタラクティブプロジェクト。",
    status: "In Development",
    href: "/projects/snapout",
  },
];
---

<BaseLayout
  title="TATTO LAB | たっと研究室"
  description="TATTO LAB / たっと研究室。AI、シミュレーション、ゲームを作って試し、分かったことを記録する個人研究・開発サイトです。"
>
  <main>
    <section class="hero">
      <p class="eyebrow">AI / SIMULATION / GAMES / EXPERIMENTS</p>
      <h1><span>作って、試して、</span><span>分かったことを残す。</span></h1>
      <p class="lead">
        AI、シミュレーション、ゲームを中心に、<br class="desktop" />
        気になったものを実際に作って検証しています。
      </p>
      <div class="hero-links">
        <a class="primary-button" href="#projects">Projectsを見る</a>
        <a class="secondary-button" href="/articles">Articles</a>
      </div>
    </section>

    <section id="projects">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SELECTED PROJECTS</p>
          <h2>Projects</h2>
        </div>
        <a href="/projects">すべて見る →</a>
      </div>

      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={project.href}>
            <div class="project-image"><span>{project.title}</span></div>
            <div class="project-content">
              <div class="project-meta"><span>{project.status}</span></div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <span class="project-link">View Project →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="articles">
      <div class="section-heading">
        <div>
          <p class="eyebrow">LATEST ARTICLE</p>
          <h2>Articles</h2>
        </div>
        <a href="/articles">すべて見る →</a>
      </div>

      <a class="article-preview" href="/articles/inheritance-village-python-authority">
        <div class="article-thumb authority-thumb" aria-hidden="true">
          <div class="authority-mini"><span>LLM</span><b>→</b><span>Python</span></div>
          <strong>WORLD<br />AUTHORITY</strong>
        </div>
        <div class="article-copy">
          <p class="article-meta">LLM / AGENT ARCHITECTURE / SIMULATION · 2026.09.02</p>
          <h3>LLMに世界を任せすぎると壊れるので、Pythonを「神」にした</h3>
          <p>LLMは意思決定、Pythonは世界の事実。自由を残しながら実験を壊さないための責任分界を振り返ります。</p>
          <strong>Read Article →</strong>
        </div>
      </a>
    </section>

    <section class="about-preview">
      <p class="eyebrow">ABOUT</p>
      <h2>たっと研究室について</h2>
      <p>
        完成したものだけではなく、試行錯誤や失敗、そこから得られた知見まで残していく個人研究・開発サイトです。
      </p>
      <a href="/about">About →</a>
    </section>
  </main>
</BaseLayout>

<style>
  main { width: min(var(--content-wide), calc(100% - 40px)); margin: 0 auto; }
  section { padding: 96px 0; }
  .hero { min-height: 650px; display: flex; flex-direction: column; justify-content: center; padding: 88px 0 120px; }
  .eyebrow { margin: 0 0 18px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.18em; }
  h1 { max-width: 980px; margin: 0; font-size: clamp(2.9rem, 5.8vw, 5.15rem); line-height: 1.04; letter-spacing: -0.05em; text-wrap: balance; word-break: auto-phrase; }
  h1 span { display: block; }
  .lead { max-width: 650px; margin: 34px 0 0; color: var(--text-muted); font-size: clamp(1rem, 2vw, 1.22rem); line-height: 1.9; }
  .hero-links { display: flex; gap: 12px; margin-top: 40px; }
  .primary-button, .secondary-button { display: inline-flex; align-items: center; justify-content: center; padding: 13px 20px; border-radius: 999px; font-size: 0.88rem; font-weight: 700; transition: 150ms ease; }
  .primary-button { background: var(--text); color: #fff; }
  .primary-button:hover { background: var(--accent); }
  .secondary-button { border: 1px solid var(--border-strong); background: rgba(255,255,255,.55); color: var(--text-muted); }
  .secondary-button:hover { border-color: var(--accent); color: var(--accent); }
  .section-heading { margin-bottom: 34px; display: flex; justify-content: space-between; align-items: flex-end; }
  .section-heading h2, .about-preview h2 { margin: 0; font-size: clamp(2.2rem, 4.5vw, 4rem); line-height: 1.08; letter-spacing: -0.045em; }
  .section-heading > a { color: var(--text-muted); font-size: .85rem; }
  .section-heading > a:hover { color: var(--accent); }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .project-card { overflow: hidden; border: 1px solid var(--border); border-radius: 20px; background: var(--surface); box-shadow: 0 1px 0 rgba(0,0,0,.02); transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease; }
  .project-card:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: var(--shadow-soft); }
  .project-image { min-height: 235px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--border); background: linear-gradient(135deg, #eef4ef, #e4ebe6); color: #819087; font-size: clamp(1.9rem, 4.2vw, 3.45rem); font-weight: 850; letter-spacing: -.045em; text-wrap: balance; }
  .project-content { padding: 26px; }
  .project-meta { margin-bottom: 14px; color: var(--accent); font-size: .72rem; font-weight: 700; text-transform: uppercase; }
  .project-content h3 { margin: 0; font-size: 1.55rem; }
  .project-content p { min-height: 64px; margin: 12px 0 22px; color: var(--text-muted); line-height: 1.75; }
  .project-link { color: var(--text); font-size: .85rem; font-weight: 700; }
  .article-preview { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); overflow: hidden; border: 1px solid var(--border); border-radius: 22px; background: var(--surface); transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease; }
  .article-preview:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: var(--shadow-soft); }
  .article-thumb { min-height: 340px; background: var(--media-bg); }
  .article-thumb img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .authority-thumb { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: center; padding: clamp(26px, 5vw, 54px); background: linear-gradient(135deg, #edf2ee, #dce8df); }
  .authority-mini { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; align-items: center; }
  .authority-mini span { display: grid; place-items: center; min-height: 70px; border: 1px solid #c6d7ca; border-radius: 14px; background: rgba(255,255,255,.58); color: var(--accent); font-size: .76rem; font-weight: 850; }
  .authority-mini b { color: #7b8c80; font-weight: 600; }
  .authority-thumb > strong { color: #26352b; font-size: clamp(2rem, 4.7vw, 4.2rem); line-height: .88; letter-spacing: -.065em; }
  .article-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 5vw, 52px); }
  .article-meta { margin: 0 0 20px; color: var(--accent); font-size: .7rem; font-weight: 700; letter-spacing: .08em; }
  .article-copy h3 { margin: 0; font-size: clamp(1.7rem, 3.2vw, 2.8rem); line-height: 1.25; letter-spacing: -.04em; text-wrap: balance; word-break: auto-phrase; }
  .article-copy > p:not(.article-meta) { margin: 22px 0; color: var(--text-muted); line-height: 1.8; }
  .article-copy strong { color: var(--accent); font-size: .84rem; }
  .about-preview { max-width: 760px; }
  .about-preview > p:not(.eyebrow) { margin: 28px 0; color: var(--text-muted); font-size: 1.1rem; line-height: 1.9; }
  .about-preview a { color: var(--accent); font-weight: 700; border-bottom: 1px solid #b8d7c3; }
  @media (max-width: 800px) { .article-preview { grid-template-columns: 1fr; } .article-thumb { min-height: 0; aspect-ratio: 16/9; } }
  @media (max-width: 700px) { .hero { min-height: 520px; padding-top: 58px; } h1 span { display: inline; } h1 span + span::before { content: " "; } .project-grid { grid-template-columns: 1fr; } .project-image { min-height: 185px; } .hero-links { flex-wrap: wrap; } .desktop { display: none; } }
</style>
