---
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = [
  { title: "Guitar AI", description: "自分のギターを高精度に切り抜くための専用AIを開発しています。", status: "IN DEVELOPMENT", href: "/projects/guitar-ai" },
  { title: "Inheritance Village", description: "コンペに向け約2週間で制作した、失敗と感情を次世代へ継承するローカルLLM社会シミュレーション。", status: "COMPETITION ENTRY · AUG 2026", href: "/projects/agent-society" },
  { title: "Voxel World", description: "Voxel世界でAIや魔法による大規模な戦争を作るゲームプロジェクト。", status: "IN DEVELOPMENT", href: "/projects/voxel-world" },
  { title: "SNAPOUT", description: "現実世界・都市データとゲームを組み合わせたインタラクティブプロジェクト。", status: "IN DEVELOPMENT", href: "/projects/snapout" },
];
---

<BaseLayout title="Projects | TATTO LAB" description="TATTO LABで進めているAI、シミュレーション、ゲーム制作のプロジェクト一覧。">
  <main>
    <p class="eyebrow">PROJECTS</p>
    <h1>作っているもの。</h1>
    <p class="lead">完成品だけでなく、開発途中の実験や検証も含めて残しています。</p>

    <div class="grid">
      {projects.map((project) => (
        <a class="card" href={project.href}>
          <span>{project.status}</span>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <strong>View Project →</strong>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  main { width: min(var(--content-wide), calc(100% - 40px)); margin: 0 auto; padding: 120px 0 40px; }
  .eyebrow { margin: 0 0 16px; font-size: .75rem; font-weight: 800; letter-spacing: .18em; }
  h1 { margin: 0; font-size: clamp(3rem, 7vw, 6rem); line-height: 1; letter-spacing: -.05em; }
  .lead { max-width: 650px; margin: 28px 0 62px; color: var(--text-muted); font-size: 1.08rem; line-height: 1.9; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .card { min-height: 330px; padding: 34px; border: 1px solid var(--border); border-radius: 20px; background: var(--surface); display: flex; flex-direction: column; transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease; }
  .card:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: var(--shadow-soft); }
  .card span { color: var(--accent); font-size: .7rem; font-weight: 700; letter-spacing: .06em; }
  .card h2 { margin: 18px 0 10px; font-size: 2rem; letter-spacing: -.035em; }
  .card p { max-width: 480px; color: var(--text-muted); line-height: 1.8; }
  .card strong { margin-top: auto; color: var(--text); font-size: .85rem; }
  @media (max-width: 700px) { main { padding-top: 80px; } .grid { grid-template-columns: 1fr; } }
</style>
