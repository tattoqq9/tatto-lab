---
const projects = [
  {
    title: "Guitar AI",
    description: "自分のギターを高精度に切り抜くための専用AIを開発しています。",
    href: "/projects/guitar-ai",
  },
  {
    title: "Agent Society",
    description: "LLMエージェントが生活し、記憶や知識を世代を越えて継承する社会シミュレーション。",
    href: "/projects/agent-society",
  },
  {
    title: "Voxel World",
    description: "Voxel世界でAIや魔法による大規模な戦争を作るゲームプロジェクト。",
    href: "/projects/voxel-world",
  },
  {
    title: "SNAPOUT",
    description: "現実世界・都市データとゲームを組み合わせたインタラクティブプロジェクト。",
    href: "/projects/snapout",
  },
];
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Projects | TATTO LAB</title>
  </head>

  <body>
    <main>
      <a class="back" href="/">← TATTO LAB</a>

      <p class="eyebrow">PROJECTS</p>
      <h1>作っているもの。</h1>

      <div class="grid">
        {projects.map((project) => (
          <a class="card" href={project.href}>
            <span>IN DEVELOPMENT</span>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            <strong>View Project →</strong>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #0a0a0a;
    color: #eee;
    font-family:
      Inter, "Noto Sans JP", "Yu Gothic", sans-serif;
  }

  main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 70px 0 120px;
  }

  .back {
    color: #888;
    text-decoration: none;
  }

  .eyebrow {
    margin-top: 120px;
    color: #84d3a1;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 15px 0 60px;
    font-size: clamp(3rem, 7vw, 6rem);
    letter-spacing: -0.05em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .card {
    min-height: 330px;
    padding: 34px;
    border: 1px solid #252525;
    border-radius: 18px;
    background: #111;
    color: inherit;
    text-decoration: none;

    display: flex;
    flex-direction: column;
  }

  .card:hover {
    border-color: #555;
  }

  .card span {
    color: #84d3a1;
    font-size: 0.7rem;
  }

  .card h2 {
    margin: 18px 0 10px;
    font-size: 2rem;
  }

  .card p {
    max-width: 480px;
    color: #999;
    line-height: 1.8;
  }

  .card strong {
    margin-top: auto;
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
