---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "TATTO LAB / たっと研究室。AI、シミュレーション、ゲームを作って実験しています。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <header>
      <a class="logo" href="/">
        <strong>TATTO LAB</strong>
        <span>たっと研究室</span>
      </a>

      <nav>
        <a href="/projects">Projects</a>
        <a href="/articles">Articles</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <slot />

    <footer>
      <strong>TATTO LAB</strong>
      <span>© 2026</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family:
      Inter, "Noto Sans JP", "Hiragino Kaku Gothic ProN",
      "Yu Gothic", sans-serif;

    color: #eeeeee;
    background: #0a0a0a;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background:
      radial-gradient(
        circle at 70% 0%,
        #18241e 0,
        transparent 32rem
      ),
      #0a0a0a;
    color: #ededed;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  header,
  footer {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  header {
    min-height: 88px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .logo strong {
    letter-spacing: 0.08em;
  }

  .logo span {
    color: #888;
    font-size: 0.72rem;
  }

  nav {
    display: flex;
    gap: 28px;
    color: #aaa;
    font-size: 0.9rem;
  }

  nav a:hover {
    color: #fff;
  }

  footer {
    margin-top: 100px;
    padding: 30px 0 50px;
    border-top: 1px solid #222;
    display: flex;
    justify-content: space-between;
    color: #666;
    font-size: 0.78rem;
  }

  @media (max-width: 700px) {
    header {
      align-items: flex-start;
      padding-top: 24px;
    }

    nav {
      gap: 14px;
      font-size: 0.75rem;
    }
  }
</style>
