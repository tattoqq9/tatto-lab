---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  headline?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const siteName = "TATTO LAB";
const siteAlternateName = "たっと研究室";
const siteDescription =
  "TATTO LAB / たっと研究室。AI、シミュレーション、ゲームを作って実験しています。";
const authorName = "たっと";

const {
  title,
  description = siteDescription,
  seoTitle = title,
  image,
  imageAlt,
  type = "website",
  headline,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://tatto-lab.pages.dev");
const normalizedPath =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "");
const canonicalUrl = new URL(normalizedPath, site);
const absoluteImage = image ? new URL(image, site).href : undefined;
const robotsContent = noindex
  ? "noindex,nofollow"
  : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";

const websiteId = new URL("/#website", site).href;
const pageId = `${canonicalUrl.href}#webpage`;
const articleHeadline = headline ?? title.replace(/\s*\|\s*TATTO LAB$/, "");

const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  url: new URL("/", site).href,
  name: siteName,
  alternateName: siteAlternateName,
  description: siteDescription,
  inLanguage: "ja",
};

const webPageSchema = {
  "@type": "WebPage",
  "@id": pageId,
  url: canonicalUrl.href,
  name: seoTitle,
  description,
  isPartOf: { "@id": websiteId },
  inLanguage: "ja",
  ...(absoluteImage
    ? {
        primaryImageOfPage: {
          "@type": "ImageObject",
          url: absoluteImage,
        },
      }
    : {}),
};

const articleSchema =
  type === "article" && publishedTime
    ? {
        "@type": "BlogPosting",
        "@id": `${canonicalUrl.href}#article`,
        mainEntityOfPage: { "@id": pageId },
        headline: articleHeadline,
        description,
        datePublished: publishedTime,
        dateModified: modifiedTime ?? publishedTime,
        inLanguage: "ja",
        author: {
          "@type": "Person",
          name: authorName,
          url: new URL("/about", site).href,
        },
        ...(absoluteImage ? { image: [absoluteImage] } : {}),
      }
    : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [websiteSchema, webPageSchema, ...(articleSchema ? [articleSchema] : [])],
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={authorName} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#f7f8f6" />

    <title>{seoTitle}</title>
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {absoluteImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

    <meta name="twitter:card" content={absoluteImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    {absoluteImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && (modifiedTime ?? publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="a28db7c9-a7b5-4b42-95a3-61104a522b30"
      data-domains="tatto-lab.pages.dev"
    ></script>
  </head>

  <body>
    <header class="site-header">
      <a class="site-logo" href="/">
        <strong>TATTO LAB</strong>
        <span>たっと研究室</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/projects">Projects</a>
        <a href="/articles">Articles</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <strong>TATTO LAB</strong>
      <span>© 2026</span>
    </footer>
  </body>
</html>
